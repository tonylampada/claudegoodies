#!/usr/bin/env node
// fm-board-sync — Loop B evidence feeder from a firstmate home's on-disk state
// onto a bridge board. Node built-ins only, zero deps. Never writes to the
// firstmate home; calls exactly the DNA sync operations and nothing else:
//
//   event.append          timeline events for detected signals (deduped by text)
//   card.patch            prs / artifacts attribute updates
//   status.set            the worker lease (evidence-based, single writer)
//   card.archive(merged)  when a task lands in backlog Done with verb "merged"
//   card.restore          when live evidence maps to an ARCHIVED card id
//   card.move             NEVER (invariant 3: sync feeds, never moves)
//
// What it does per run:
//   1. Ensures the canonical 4-column frame (PUT /api/columns, idempotent).
//   2. Creates cards for NEW in-flight work (backlog In flight + live state/*.meta),
//      born in "working" with type/repo/owner attributes and a seed body. On birth,
//      a data/<task-id>/brief.md in the home is attached as a {uri, label} entry in
//      the `artifacts` list attribute; artifacts are additive only (append missing
//      entries, never overwrite an existing list).
//      Resurrection: when the live work's card id is NOT on the board but IS in the
//      archive (most recent record), the feeder calls card.restore instead — frozen
//      history intact plus a loud level-1 "resurrected — work is still running"
//      event — never a blank rebirth. Birth is only for ids never archived. Alias
//      targets in the archive restore the same way (an alias explicitly links live
//      work to that card); the subagent registry still never mints and never
//      restores (it rides existing cards only). The archive record remains
//      (append-only log): the board is truth for liveness.
//   3. Appends timeline events for detected signals, deduped by exact text:
//        - "PR opened <url>" when meta records pr=          (level 2)
//        - status-file lines: done/failed/needs-decision/blocked -> level 1
//          (success/alert/question/alert), other lines -> level 2
//   4. Maintains the `prs` list attribute: [{url, state: open|merged|closed}]
//      from the task meta's recorded PR (open) and backlog Done verbs (merged).
//      Cards still carrying the old `pr`/`pr_state` attributes are migrated:
//      folded into `prs`, old keys deleted (PATCH value null deletes).
//   5. Asserts the worker lease via status.set — EVIDENCE-BASED, never sampled
//      from screen panes. Per linked task (aliases + task-id match):
//        - last state/<id>.status line starts needs-decision:/blocked: -> needs-you
//        - else recent activity (mtime of state/<id>.status or
//          state/<id>.turn-ended within FM_SYNC_FRESH_SECS, default 600) -> working
//        - else task meta still exists -> idle
//        - task meta gone (torn down) -> one status.set with worker null (the
//          unlink), then stop asserting
//      The lease is re-asserted every run with ttl FM_SYNC_WORKER_TTL_SECS
//      (default 600, 2x the default sync cadence); server-side decay covers a
//      dead feeder honestly. The `worker` attribute is never written.
//      Firstmate's own subagent-delegates also hold leases: state/subagents.json
//      entries RIDE their linked card (see fm-subagent) with worker id = agent id.
//      Lease priority per card, highest first: registry > alias > crew task.
//   6. Archives a card when its task lands in backlog Done with verb "merged":
//      card.archive with reason enum "merged" (plus the PR url / "local main"
//      as note). Nothing else ever removes a card.
//
// Aliases: <home>/data/board-aliases lines "<task-id> <card-id>" feed a task's
// events/attributes/lease onto an existing card (e.g. a captain-created card
// that became real work) instead of creating a new one.
//
// Usage:
//   fm-board-sync [--home <path>] [--owner <name>] [--no-secondmates]
//                 [--apply] [--port <p>] [--board <name>]
// Without --apply: prints the planned actions as JSON (nothing is sent).
'use strict';

const fs = require('fs');
const path = require('path');
const http = require('http');

function warn(msg) { process.stderr.write('fm-board-sync: ' + msg + '\n'); }

// ---------- args ----------
const argv = process.argv.slice(2);
const opts = {
  home: process.env.FM_HOME || process.cwd(),
  owner: 'firstmate',
  secondmates: true,
  apply: false,
  port: 4777,
  board: 'default',
};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--home') opts.home = argv[++i];
  else if (a === '--owner') opts.owner = argv[++i];
  else if (a === '--no-secondmates') opts.secondmates = false;
  else if (a === '--apply') opts.apply = true;
  else if (a === '--port') opts.port = parseInt(argv[++i], 10);
  else if (a === '--board') opts.board = argv[++i];
  else { warn('unknown option: ' + a); process.exit(2); }
}
const BASE = 'http://127.0.0.1:' + opts.port;

// ---------- evidence-policy knobs ----------
function envSecs(name, dflt, min) {
  const v = parseFloat(process.env[name]);
  return Number.isFinite(v) && v >= min ? v : dflt;
}
// Activity within this window counts as "working" evidence (0 = nothing is fresh).
const FRESH_SECS = envSecs('FM_SYNC_FRESH_SECS', 600, 0);
// Worker lease ttl; the feeder re-asserts every run, decay covers a dead feeder.
const WORKER_TTL_SECS = envSecs('FM_SYNC_WORKER_TTL_SECS', 600, 0.001);

// ---------- canonical column frame (skill-owned) ----------
const COLUMNS = [
  { id: 'ideas', title: '💡 Ideas' },
  { id: 'working', title: '🔨 Working' },
  { id: 'review', title: '👀 Your review' },
  { id: 'peer', title: '🤝 Peer review' },
];
const BIRTH_COLUMN = 'working'; // new detected work is already being worked

// ---------- helpers ----------
function readFileSafe(file) {
  try { return fs.readFileSync(file, 'utf8'); } catch (e) { return null; }
}
function mtimeMs(file) {
  try { return fs.statSync(file).mtimeMs; } catch (e) { return null; }
}
function trimTrailingParen(text) {
  return text.replace(/\s*\([^()]*\)\s*$/, '').trim();
}

// ---------- backlog parsing ----------
// {inflight:[{id,text,repo}], done:[{id,text,url,verb}]}
function parseBacklog(file) {
  const out = { inflight: [], done: [] };
  const src = readFileSafe(file);
  if (src == null) { warn('no backlog at ' + file + ' (skipped)'); return out; }
  let section = null;
  for (const raw of src.split('\n')) {
    const h2 = /^##\s+(.*)$/.exec(raw);
    if (h2) {
      const t = h2[1].replace(/^[^A-Za-z0-9]+/, '');
      if (/^in flight/i.test(t)) section = 'inflight';
      else if (/^done\b/i.test(t)) section = 'done';
      else section = null;
      continue;
    }
    if (/^###/.test(raw)) continue;
    if (!section) continue;
    const item = /^\s*- (?:\[( |x)\]\s+)?\**(\S+?)\**\s+-\s+(.*\S)\s*$/.exec(raw);
    if (!item) continue;
    const id = item[2];
    const text = item[3];
    const rec = { id, text, repo: null, url: null, verb: null };
    const repoM = /\(repo:\s*([^,;)]+)/.exec(text);
    if (repoM) rec.repo = repoM[1].trim();
    if (section === 'done') {
      // "- [x] <id> - <one line> - <url-or-path-or-note> (<verb> <date>)"
      const tail = /^(.*\S)\s+-\s+(.+?)\s+\((\w+)[^)]*\)\s*$/.exec(text);
      if (tail) { rec.text = tail[1]; rec.url = tail[2]; rec.verb = tail[3].toLowerCase(); }
    }
    out[section].push(rec);
  }
  return out;
}

// ---------- meta / status parsing ----------
function parseMetas(stateDir) {
  const metas = new Map(); // id -> {kind, project, prs[]}
  let names;
  try { names = fs.readdirSync(stateDir).filter((n) => n.endsWith('.meta')).sort(); }
  catch (e) { return metas; }
  for (const name of names) {
    const id = name.slice(0, -'.meta'.length);
    const src = readFileSafe(path.join(stateDir, name));
    if (src == null) continue;
    const m = { kind: null, project: null, prs: [] };
    for (const line of src.split('\n')) {
      const kv = /^(\w+)=(.*)$/.exec(line.trim());
      if (!kv) continue;
      if (kv[1] === 'pr') { if (kv[2] && !m.prs.includes(kv[2])) m.prs.push(kv[2]); }
      else if (kv[1] in m) m[kv[1]] = kv[2];
    }
    metas.set(id, m);
  }
  return metas;
}
function parseStatus(stateDir, id) {
  const src = readFileSafe(path.join(stateDir, id + '.status'));
  if (src == null) return [];
  return src.split('\n').map((s) => s.trim()).filter(Boolean);
}

// status line -> {level, kind} (handoff-worthy signals are level 1)
function classifyStatusLine(line) {
  if (/^done\b/i.test(line)) return { level: 1, kind: 'success' };
  if (/^failed\b/i.test(line)) return { level: 1, kind: 'alert' };
  if (/^needs-decision\b/i.test(line)) return { level: 1, kind: 'question' };
  if (/^blocked\b/i.test(line)) return { level: 1, kind: 'alert' };
  return { level: 2, kind: 'info' };
}

// ---------- worker lease evidence ----------
// The lease is derived from on-disk EVIDENCE only — status lines and turn-end
// activity — never from screen/pane sampling. Returns {id, state} for a live
// task, or null for a torn-down one (meta gone: unlink).
function lastStatusVerb(statusLines) {
  if (!statusLines.length) return null;
  const line = statusLines[statusLines.length - 1];
  return line.split(':')[0].trim().toLowerCase();
}
function workerEvidence(stateDir, taskId, meta, statusLines) {
  if (!meta) return null; // torn down: unlink
  const verb = lastStatusVerb(statusLines);
  if (verb === 'needs-decision' || verb === 'blocked') return { id: taskId, state: 'needs-you' };
  const cutoff = Date.now() - FRESH_SECS * 1000;
  for (const f of [taskId + '.status', taskId + '.turn-ended']) {
    const m = mtimeMs(path.join(stateDir, f));
    if (m != null && m >= cutoff) return { id: taskId, state: 'working' };
  }
  return { id: taskId, state: 'idle' }; // alive but no recent activity
}

// ---------- prs list: [{url, state: open|merged|closed}] ----------
const PR_STATES = new Set(['open', 'merged', 'closed']);
function normalizePrs(list) {
  const out = [];
  if (!Array.isArray(list)) return out;
  for (const e of list) {
    if (!e || typeof e !== 'object' || typeof e.url !== 'string' || !e.url) continue;
    if (out.some((x) => x.url === e.url)) continue;
    out.push({ url: e.url, state: PR_STATES.has(e.state) ? e.state : 'open' });
  }
  return out;
}
// Merge PR facts into a card's prs attribute; folds the old pr/pr_state pair in
// and deletes those keys (migration). addOpen: urls known open (task meta);
// markMerged: urls known merged (backlog Done). Emits at most one attrs patch.
function planPrs(id, card, addOpen, markMerged, plan) {
  const at = card.attributes || {};
  const legacy = ('pr' in at) || ('pr_state' in at);
  if (!legacy && !addOpen.length && !markMerged.length) return;
  const prs = normalizePrs(at.prs);
  if (legacy && typeof at.pr === 'string' && at.pr && !prs.some((e) => e.url === at.pr)) {
    prs.push({ url: at.pr, state: PR_STATES.has(at.pr_state) ? at.pr_state : 'open' });
  }
  for (const url of addOpen) {
    if (!prs.some((e) => e.url === url)) prs.push({ url, state: 'open' });
  }
  for (const url of markMerged) {
    const e = prs.find((x) => x.url === url);
    if (e) e.state = 'merged';
    else prs.push({ url, state: 'merged' });
  }
  if (card._new) { if (prs.length) card.attributes.prs = prs; return; }
  if (!legacy && JSON.stringify(prs) === JSON.stringify(normalizePrs(at.prs))) return;
  const attributes = { prs };
  if (legacy) { attributes.pr = null; attributes.pr_state = null; } // null deletes
  plan.attrs.push({ card: id, attributes });
}

// ---------- artifacts: [{uri, label}] — additive only ----------
function planArtifact(id, card, uri, label, plan) {
  const at = card.attributes || {};
  const list = Array.isArray(at.artifacts) ? at.artifacts.slice() : [];
  if (list.some((a) => a && a.uri === uri)) return;
  list.push({ uri, label });
  if (card._new) { card.attributes.artifacts = list; return; }
  plan.attrs.push({ card: id, attributes: { artifacts: list } });
}

// ---------- aliases: "<task-id> <card-id>" ----------
function parseAliases(file) {
  const map = new Map();
  const src = readFileSafe(file);
  if (src == null) return map;
  for (const raw of src.split('\n')) {
    const line = raw.replace(/#.*$/, '').trim();
    if (!line) continue;
    const m = /^(\S+)\s+(\S+)$/.exec(line);
    if (m) map.set(m[1], m[2]);
    else warn('bad alias line in ' + file + ': ' + raw.trim());
  }
  return map;
}

// ---------- subagent registry: state/subagents.json ----------
// { "<agent-id>": { "card": "<card-id>", "state": "working|idle|needs-you" } }
// Firstmate's direct subagent-delegates RIDE the card they are linked to (they
// have no card of their own): the registry asserts a status.set lease with
// worker id = agent id onto that card, re-asserted here every run while
// registered (fm-subagent writes the entry and fires the first status.set).
// Absent, unreadable, or corrupt file => empty (no subagents), never fatal.
// Returns Map<cardId, {id, state}>, dropping entries with an unknown state or
// missing card.
const SUBAGENT_STATES = new Set(['working', 'idle', 'needs-you']);
function parseSubagents(file) {
  const map = new Map(); // cardId -> {id: agentId, state}
  const src = readFileSafe(file);
  if (src == null) return map;
  let obj;
  try { obj = JSON.parse(src); } catch (e) { warn('corrupt subagents.json at ' + file + ' (treated as empty)'); return map; }
  if (!obj || typeof obj !== 'object' || Array.isArray(obj)) return map;
  for (const [agentId, ent] of Object.entries(obj)) {
    if (!ent || typeof ent !== 'object') continue;
    const card = ent.card;
    const state = ent.state;
    if (typeof card !== 'string' || !card) continue;
    if (!SUBAGENT_STATES.has(state)) { warn('subagent ' + agentId + ': bad state "' + state + '" (skipped)'); continue; }
    // Last writer wins if two agents ride the same card (the lease is decided
    // once per card anyway; this just keeps the map single-valued).
    map.set(card, { id: agentId, state });
  }
  return map;
}

// ---------- secondmate registry ----------
function parseSecondmates(file) {
  const out = [];
  const src = readFileSafe(file);
  if (src == null) return out;
  for (const raw of src.split('\n')) {
    const m = /^\s*-\s+(\S+)\s+-\s+.*\(home:\s*([^;)]+)/.exec(raw);
    if (m) out.push({ id: m[1], home: m[2].trim() });
  }
  return out;
}

// ---------- resurrection snapshot ----------
// The frozen card from an archive record, normalized for planning: after the
// restore is applied it IS the board card, so events dedupe and prs/artifacts
// patches plan against it exactly like an existing card (no _new flag: the
// patches ride plan.attrs, applied after the restore).
function restoredCard(rec) {
  const card = JSON.parse(JSON.stringify(rec.card));
  if (!Array.isArray(card.events)) card.events = [];
  if (!Array.isArray(card.thread)) card.thread = [];
  if (!card.attributes || typeof card.attributes !== 'object') card.attributes = {};
  return card;
}

// ---------- plan for one home ----------
// Emits {creates:[card], restores:[{card,text}], events:[{card,text,level,kind}],
//        attrs:[{card,attributes}], statuses:[{card,worker}],
//        archives:[{card,reason,note}], statusDecided:Set<cardId>,
//        prsDecided:Set<cardId>} against the board snapshot (archived = most
// recent archive record per card id). statusDecided = cards whose worker lease
// this home owns this run; main() unlinks any other owned card that still shows
// a linked worker.
function planHome(home, owner, board, archived) {
  const backlog = parseBacklog(path.join(home, 'data', 'backlog.md'));
  const stateDir = path.join(home, 'state');
  const metas = parseMetas(stateDir);
  const aliases = parseAliases(path.join(home, 'data', 'board-aliases'));
  const subagents = parseSubagents(path.join(stateDir, 'subagents.json'));
  const plan = {
    creates: [], restores: [], events: [], attrs: [], statuses: [], archives: [],
    statusDecided: new Set(), prsDecided: new Set(),
  };

  const cardId = (taskId) =>
    aliases.get(taskId) || (owner === 'firstmate' ? taskId : owner + ':' + taskId);
  const boardCard = (id) => (board.cards || []).find((c) => c.id === id);

  // Assert the worker lease for one card, deterministically: at most ONE lease
  // decision per card per run. worker = {id, state} re-asserts the lease (every
  // run — that is the refresh that keeps a live lease from decaying); worker =
  // null unlinks, but only when the board still shows a linked worker, so a
  // torn-down task unlinks ONCE and then stops asserting. A second attempt to
  // decide the same card in one run is ignored (the first, authoritative source
  // wins); callers order the authoritative source first.
  const feedStatus = (id, card, worker) => {
    if (plan.statusDecided.has(id)) return; // already decided this run
    plan.statusDecided.add(id);
    if (!card) return; // no card on the board (and none being created)
    if (worker == null) {
      const w = card.status && card.status.worker;
      if (!card._new && w && w.id) plan.statuses.push({ card: id, worker: null });
      return;
    }
    plan.statuses.push({ card: id, worker });
  };

  // live tasks = in-flight backlog items U live metas (minus secondmate self-records)
  const live = new Map(); // taskId -> {title, repo, kind}
  for (const it of backlog.inflight) {
    live.set(it.id, { title: trimTrailingParen(it.text) || it.id, repo: it.repo, kind: null });
  }
  for (const [id, m] of metas) {
    if (m.kind === 'secondmate') {
      live.delete(id);
      continue;
    }
    const t = live.get(id) || { title: id, repo: null, kind: null };
    if (m.kind) t.kind = m.kind;
    if (!t.repo && m.project) t.repo = path.basename(m.project);
    live.set(id, t);
  }

  // Lease priority, highest first: REGISTRY (firstmate's subagent-delegates) >
  // ALIAS (rework task riding a card) > CREW TASK (crewmate/secondmate task).
  // Each source is decided before the next, and feedStatus() is idempotent per
  // card, so the highest-priority source wins with no double-write.
  //
  // 1) REGISTRY first: a subagent rides its linked card outright — a crew-task
  //    lease computation and the main() unlink sweep must never clobber or clear
  //    it (statusDecided marks it ours). Ride only an existing board card: never
  //    mint a card here. A card the registry no longer names falls back to the
  //    normal alias/crew computation next run, which for a taskless subagent
  //    card is an unlink — so clearing an entry clears the lease cleanly.
  for (const [cardIdName, worker] of subagents) {
    const card = boardCard(cardIdName);
    if (!card) continue; // linked card not on the board: skip, don't mint
    feedStatus(cardIdName, card, worker);
  }

  // 2) ALIAS next: the aliasing (rework) task is the authoritative source for
  // an alias-target card, before any same-named original task (whose torn-down
  // meta would otherwise unlink that card). feedStatus() is idempotent per card,
  // so the first (alias) decision wins. A task reaching a card by the default id
  // mapping (not through an alias) is not pre-decided here.
  for (const [taskId, targetCard] of aliases) {
    const m = metas.get(taskId);
    if (!m) continue; // alias to a task with no meta: nothing live to feed
    const card = boardCard(targetCard);
    if (!card) continue; // alias target not on the board yet (created or restored below if it is live work)
    feedStatus(targetCard, card, workerEvidence(stateDir, taskId, m, parseStatus(stateDir, taskId)));
  }

  // Secondmate self-records create no card, but a card may exist for one (alias
  // or direct id); assert its lease from the same evidence policy.
  for (const [id, m] of metas) {
    if (m.kind !== 'secondmate') continue;
    const cid = cardId(id);
    feedStatus(cid, boardCard(cid), workerEvidence(stateDir, id, m, parseStatus(stateDir, id)));
  }

  // pending events/attrs for a card id, deduped later against board card events
  for (const [taskId, t] of live) {
    const id = cardId(taskId);
    let card = boardCard(id);
    if (!card && archived.has(id)) {
      // ARCHIVED id with live evidence: resurrect the frozen card (card.restore,
      // most recent record), never a blank rebirth. The frozen snapshot plans as
      // the board card, so history dedupes and patches ride after the restore.
      card = restoredCard(archived.get(id));
      plan.restores.push({ card: id, text: 'resurrected — work is still running' });
    } else if (!card) {
      // NEW work, never archived: the only time this feeder creates (and seeds
      // title/body)
      const type = t.kind === 'scout' ? 'investigation' : 'implementation';
      const attributes = { type, owner };
      if (t.repo) attributes.repo = t.repo;
      card = {
        id, title: t.title, column: BIRTH_COLUMN, attributes,
        body: t.title + (t.repo ? ' (' + t.repo + ')' : ''),
      };
      plan.creates.push(card);
      card._new = true;
    }
    const have = new Set(((card.events) || []).map((e) => e.text));
    const addEvent = (text, level, kind) => {
      if (have.has(text)) return;
      have.add(text);
      plan.events.push({ card: id, text, level, kind });
    };

    // PR recorded in meta -> prs list entry (open) + one "PR opened" event
    const m = metas.get(taskId);
    planPrs(id, card, m ? m.prs : [], [], plan);
    plan.prsDecided.add(id);
    if (m && m.prs.length) addEvent('PR opened: ' + m.prs[m.prs.length - 1], 2, 'info');

    // brief artifact: attach the worker brief when the home has one
    const brief = path.join(home, 'data', taskId, 'brief.md');
    if (fs.existsSync(brief)) planArtifact(id, card, 'file://' + brief, 'worker brief', plan);

    // status-file lines -> timeline events
    const statusLines = parseStatus(stateDir, taskId);
    for (const line of statusLines) {
      const c = classifyStatusLine(line);
      addEvent(line, c.level, c.kind);
    }

    // worker lease from evidence (re-asserted when live, unlinked when gone)
    feedStatus(id, card, workerEvidence(stateDir, taskId, m, statusLines));
  }

  // merged Done entries -> mark the PR merged, archive the card (reason enum)
  for (const it of backlog.done) {
    if ((it.verb || '') !== 'merged') continue;
    const id = cardId(it.id);
    const card = boardCard(id);
    if (!card) continue; // already archived / never on the board
    const isUrl = it.url && /^https?:\/\//.test(it.url);
    planPrs(id, card, [], isUrl ? [it.url] : [], plan);
    plan.prsDecided.add(id);
    plan.archives.push({ card: id, reason: 'merged', note: isUrl ? it.url : 'local main' });
  }

  return plan;
}

// ---------- http ----------
function request(method, urlPath, body) {
  return new Promise((resolve, reject) => {
    const data = body == null ? null : JSON.stringify(body);
    const req = http.request(BASE + urlPath, {
      method,
      headers: data ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } : {},
      timeout: 10000,
    }, (res) => {
      let out = '';
      res.on('data', (c) => (out += c));
      res.on('end', () => {
        if (res.statusCode >= 400) return reject(new Error('HTTP ' + res.statusCode + ' ' + urlPath + ': ' + out));
        try { resolve(JSON.parse(out)); } catch (e) { resolve(out); }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timeout')));
    req.on('error', reject);
    if (data) req.write(data);
    req.end();
  });
}

// ---------- main ----------
async function main() {
  const home = path.resolve(opts.home);
  if (!fs.existsSync(home)) { warn('home does not exist: ' + home); process.exit(0); }

  // A server serves one board fixed at launch; verify before feeding anything.
  let board = { cards: [] };
  try {
    const st = await request('GET', '/api/status');
    if (st && st.board && st.board !== opts.board) {
      warn('server on port ' + opts.port + ' serves board "' + st.board + '", not "' + opts.board + '" — refusing');
      process.exit(1);
    }
    board = await request('GET', '/api/board');
  } catch (e) {
    warn('server not reachable on port ' + opts.port + ': ' + e.message + (opts.apply ? '' : ' (planning against empty board)'));
    if (opts.apply) process.exit(1);
  }

  // archive index for resurrection: most recent record per card id (the archive
  // endpoint serves newest first, so the first hit per id wins). A read failure
  // only disables resurrection for this run, never the rest of the sync.
  const archived = new Map();
  try {
    const arch = await request('GET', '/api/archive?limit=1000000');
    for (const rec of (arch && arch.archive) || []) {
      if (rec && rec.card && rec.card.id && !archived.has(rec.card.id)) archived.set(rec.card.id, rec);
    }
  } catch (e) {
    warn('archive not readable on port ' + opts.port + ': ' + e.message + ' (resurrection disabled this run)');
  }

  // merge plans across the main home and each secondmate home
  const plan = { columns: COLUMNS, creates: [], restores: [], events: [], attrs: [], statuses: [], archives: [] };
  const homes = [{ home, owner: opts.owner }];
  if (opts.secondmates) {
    for (const sm of parseSecondmates(path.join(home, 'data', 'secondmates.md'))) {
      if (!fs.existsSync(sm.home)) { warn('secondmate home missing: ' + sm.home + ' (skipped)'); continue; }
      homes.push({ home: path.resolve(sm.home), owner: sm.id });
    }
  }
  const statusDecided = new Set();
  const prsDecided = new Set();
  for (const h of homes) {
    const p = planHome(h.home, h.owner, board, archived);
    plan.creates.push(...p.creates);
    plan.restores.push(...p.restores);
    plan.events.push(...p.events);
    plan.attrs.push(...p.attrs);
    plan.statuses.push(...p.statuses);
    plan.archives.push(...p.archives);
    for (const id of p.statusDecided) statusDecided.add(id);
    for (const id of p.prsDecided) prsDecided.add(id);
  }
  for (const c of plan.creates) delete c._new;

  // Unlink sweep: a board card still showing a linked worker whose task no
  // longer exists in any planned home (meta gone after teardown) gets one
  // status.set with worker null. Scoped to cards owned by the homes we actually
  // planned, so cards of a skipped home (--no-secondmates, missing home) are
  // never touched.
  const plannedOwners = new Set(homes.map((h) => h.owner));
  for (const c of board.cards || []) {
    if (statusDecided.has(c.id)) continue;
    if (!plannedOwners.has((c.attributes || {}).owner)) continue;
    const w = c.status && c.status.worker;
    if (w && w.id) plan.statuses.push({ card: c.id, worker: null });
  }

  // Migration sweep: owned cards still carrying the old pr/pr_state attributes
  // but no live task this run (e.g. parked in review) fold them into prs too.
  for (const c of board.cards || []) {
    if (prsDecided.has(c.id)) continue;
    if (!plannedOwners.has((c.attributes || {}).owner)) continue;
    planPrs(c.id, c, [], [], plan);
  }

  if (!opts.apply) {
    process.stdout.write(JSON.stringify(plan, null, 2) + '\n');
    return;
  }

  // apply: columns (idempotent) -> creates -> restores -> attrs -> statuses ->
  // events -> archives
  await request('PUT', '/api/columns', plan.columns);
  let n = { created: 0, restored: 0, attrs: 0, statuses: 0, events: 0, archived: 0 };
  for (const c of plan.creates) {
    try { await request('POST', '/api/cards', c); n.created++; }
    catch (e) { warn('create ' + c.id + ' failed: ' + e.message); }
  }
  for (const rs of plan.restores) {
    try {
      await request('POST', '/api/cards/' + encodeURIComponent(rs.card) + '/restore',
        { text: rs.text, actor: 'sync' });
      n.restored++;
    } catch (e) { warn('restore ' + rs.card + ' failed: ' + e.message); }
  }
  for (const a of plan.attrs) {
    try { await request('PATCH', '/api/cards/' + encodeURIComponent(a.card), { attributes: a.attributes }); n.attrs++; }
    catch (e) { warn('attrs ' + a.card + ' failed: ' + e.message); }
  }
  for (const st of plan.statuses) {
    try {
      await request('POST', '/api/cards/' + encodeURIComponent(st.card) + '/status',
        { worker: st.worker, ttl: WORKER_TTL_SECS });
      n.statuses++;
    } catch (e) { warn('status ' + st.card + ' failed: ' + e.message); }
  }
  for (const ev of plan.events) {
    try {
      await request('POST', '/api/cards/' + encodeURIComponent(ev.card) + '/events',
        { text: ev.text, level: ev.level, kind: ev.kind, actor: 'sync' });
      n.events++;
    } catch (e) { warn('event ' + ev.card + ' failed: ' + e.message); }
  }
  for (const ar of plan.archives) {
    try {
      await request('POST', '/api/cards/' + encodeURIComponent(ar.card) + '/archive',
        { reason: ar.reason, note: ar.note, actor: 'sync' });
      n.archived++;
    } catch (e) { warn('archive ' + ar.card + ' failed: ' + e.message); }
  }
  process.stdout.write(JSON.stringify(n) + '\n');
}

main().catch((e) => { warn(e.message); process.exit(1); });
