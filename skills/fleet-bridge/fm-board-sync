#!/usr/bin/env node
// fm-board-sync — deterministic bridge-board generator from a firstmate home's on-disk state.
// Reads data/backlog.md, state/*.meta, data/secondmates.md (read-only) and emits
// {"upsert":[...],"remove":[]} card upserts for PATCH /api/cards on the bridge server.
// Node built-ins only, zero deps. Never writes to the firstmate home.
//
// Usage:
//   fm-board-sync [--home <path>] [--owner <name>] [--no-secondmates] [--done <n>]
//                 [--apply] [--port <p>] [--board <name>]
//
// Without --apply: prints the raw generated JSON to stdout (full cards, no board diff).
// With --apply: PATCHes the local bridge server (defaults match bridge-axi: port 4777,
// board "default") and prints the server reply; also prints an advisory stderr line
// listing task-shaped board cards owned by an emitted owner that were NOT regenerated
// (possible stale cards). remove is never computed automatically — standing/hand-made
// cards survive. Sticky curation (--apply only): for card ids already on the board,
// title and summary are stripped from the upsert so human retouches persist; brand-new
// cards keep the generated title/summary as a seed.
'use strict';

const fs = require('fs');
const path = require('path');
const http = require('http');
const { execFileSync } = require('child_process');

function warn(msg) { process.stderr.write('fm-board-sync: ' + msg + '\n'); }

// ---------- args ----------
const argv = process.argv.slice(2);
const opts = {
  home: process.env.FM_HOME || process.cwd(),
  owner: 'firstmate',
  secondmates: true,
  done: 5,
  apply: false,
  port: 4777,
  board: 'default',
};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--home') opts.home = argv[++i];
  else if (a === '--owner') opts.owner = argv[++i];
  else if (a === '--include-secondmates') opts.secondmates = true;
  else if (a === '--no-secondmates') opts.secondmates = false;
  else if (a === '--done') opts.done = parseInt(argv[++i], 10) || 0;
  else if (a === '--apply') opts.apply = true;
  else if (a === '--port') opts.port = parseInt(argv[++i], 10);
  else if (a === '--board') opts.board = argv[++i];
  else { warn('unknown option: ' + a); process.exit(2); }
}

// ---------- canonical column frame (skill-owned; reproduced on every --apply) ----------
// ids match the column placement this generator assigns (inflight/waiting/done); ideas is
// part of the declared frame but has no generator card mapping (hand-curated cards only).
const COLUMNS = [
  { id: 'inflight', title: '🔨 In flight' },
  { id: 'waiting', title: '⏳ Awaiting merge (captain)' },
  { id: 'done', title: '✅ Delivered (recent)' },
  { id: 'ideas', title: '💡 Ideas / Discussion' },
];

// ---------- helpers ----------
function readFileSafe(file) {
  try { return fs.readFileSync(file, 'utf8'); } catch (e) { return null; }
}

// Live tmux windows ("session:window_name"); null when tmux is unavailable
// (then window liveness is unknown and nothing is demoted on that basis).
function liveWindows() {
  try {
    const out = execFileSync('tmux', ['list-windows', '-a', '-F', '#{session_name}:#{window_name}'],
      { stdio: ['ignore', 'pipe', 'ignore'], encoding: 'utf8' });
    return new Set(out.split('\n').map((s) => s.trim()).filter(Boolean));
  } catch (e) { return null; }
}

function prNumber(url) {
  const m = /\/pull\/(\d+)/.exec(url);
  return m ? m[1] : null;
}

// Trim one trailing "(...)" parenthetical (the "(repo: x, since d)" / "(merged d)" tail).
function trimTrailingParen(text) {
  return text.replace(/\s*\([^()]*\)\s*$/, '').trim();
}

// ---------- backlog parsing ----------
// Returns {inflight:[item], waiting:[item], done:[item]}; item = {id, text, repo, url, verb}.
// Section switching happens on "## " headings only; deeper "### " headings are free-form
// notes inside a section and never switch it. Unparseable lines are skipped silently.
function parseBacklog(file) {
  const out = { inflight: [], waiting: [], done: [] };
  const src = readFileSafe(file);
  if (src == null) { warn('no backlog at ' + file + ' (skipped)'); return out; }
  let section = null;
  for (const raw of src.split('\n')) {
    const h2 = /^##\s+(.*)$/.exec(raw);
    if (h2) {
      const t = h2[1].replace(/^[^A-Za-z0-9]+/, ''); // strip emoji/symbol prefix
      if (/^in flight/i.test(t)) section = 'inflight';
      else if (/PR ready|awaiting.*merge/i.test(t)) section = 'waiting';
      else if (/^done\b/i.test(t)) section = 'done';
      else section = null; // Queued and free-form h2 sections are ignored in v1
      continue;
    }
    if (/^###/.test(raw)) continue; // free-form sub-heading, keep current section
    if (!section) continue;
    const item = /^\s*- \[( |x)\]\s+(\S+)\s+-\s+(.*\S)\s*$/.exec(raw);
    if (!item) continue;
    const id = item[2];
    let text = item[3];
    const rec = { id, text, repo: null, url: null, verb: null };
    const repoM = /\(repo:\s*([^,;)]+)/.exec(text);
    if (repoM) rec.repo = repoM[1].trim();
    if (section === 'done') {
      // "- [x] <id> - <one line> - <url-or-path> (<verb> <date>)"
      const tail = /^(.*\S)\s+-\s+(\S+)\s+\((\w+)[^)]*\)\s*$/.exec(text);
      if (tail) { rec.text = tail[1]; rec.url = tail[2]; rec.verb = tail[3].toLowerCase(); }
    }
    out[section].push(rec);
  }
  return out;
}

// ---------- meta parsing ----------
// Returns map id -> {kind, mode, window, project, prs:[url]}.
function parseMetas(stateDir) {
  const metas = new Map();
  let names;
  try { names = fs.readdirSync(stateDir).filter((n) => n.endsWith('.meta')).sort(); }
  catch (e) { warn('no state dir at ' + stateDir + ' (skipped)'); return metas; }
  for (const name of names) {
    const id = name.slice(0, -'.meta'.length);
    const src = readFileSafe(path.join(stateDir, name));
    if (src == null) continue;
    const m = { kind: null, mode: null, window: null, project: null, projects: null, prs: [] };
    for (const line of src.split('\n')) {
      const kv = /^(\w+)=(.*)$/.exec(line.trim());
      if (!kv) continue;
      const [, k, v] = kv;
      if (k === 'pr') { if (v && !m.prs.includes(v)) m.prs.push(v); }
      else if (k in m) m[k] = v;
    }
    metas.set(id, m);
  }
  return metas;
}

// ---------- board aliases ----------
// Optional <home>/data/board-aliases: "<task-id> <card-id>" lines (# comments, blanks ok).
// An aliased task (e.g. a follow-up amending an existing PR) emits NO card of its own;
// while it is in flight its liveness promotes the TARGET card's column to inflight for
// this sync. Task ids are home-local; the target is the FINAL board card id (bare or
// owner-prefixed). When the aliased task disappears, the target falls back to its own
// record's column — no special handling.
function parseAliases(file) {
  const map = new Map();
  const src = readFileSafe(file);
  if (src == null) return map;
  for (const raw of src.split('\n')) {
    const line = raw.replace(/#.*$/, '').trim();
    if (!line) continue;
    const m = /^(\S+)\s+(\S+)$/.exec(line);
    if (m) map.set(m[1], m[2]);
    else warn('bad alias line in ' + file + ': ' + raw.trim());
  }
  return map;
}

// ---------- card assembly for one home ----------
const COLUMN_RANK = { inflight: 0, waiting: 1, done: 2 };

// Done-verb badges this generator emits (plus any card-specific parsed verb).
// A promoted target must not stay tagged with one while it is back in flight.
const DONE_VERB_BADGES = new Set(['merged', 'reported', 'fixed', 'shipped', 'done']);
function promotionBadges(badges, extraVerb) {
  const out = (Array.isArray(badges) ? badges : []).filter((b) => {
    if (!b) return false;
    const t = String(b.text || '').toLowerCase();
    return !DONE_VERB_BADGES.has(t) && t !== String(extraVerb || '').toLowerCase() && t !== 'reworking';
  });
  out.push({ text: 'reworking', tone: 'warn' });
  return out;
}

function cardsForHome(home, owner, windows) {
  const backlog = parseBacklog(path.join(home, 'data', 'backlog.md'));
  const metas = parseMetas(path.join(home, 'state'));
  const cards = new Map(); // task id -> card draft {column, title, summary, repo, kind, prs[], doneUrl, verb}

  function draft(id) {
    if (!cards.has(id)) cards.set(id, { column: null, title: id, summary: null, repo: null, kind: null, prs: [], doneUrl: null, verb: null });
    return cards.get(id);
  }

  // In-flight backlog items.
  for (const it of backlog.inflight) {
    const c = draft(it.id);
    c.column = 'inflight';
    c.title = trimTrailingParen(it.text) || it.id;
    c.summary = it.text;
    if (it.repo) c.repo = it.repo;
  }

  // Live meta files (union with backlog; meta-only tasks still get an inflight card).
  for (const [id, m] of metas) {
    // A secondmate's own work is represented via recursion into its home; no self-card.
    if (m.kind === 'secondmate') { cards.delete(id); continue; }
    const c = draft(id);
    if (!c.column) c.column = 'inflight';
    if (m.kind) c.kind = m.kind;
    // For a secondmate the project= points at its own home; badge its projects= list instead.
    if (!c.repo) c.repo = m.kind === 'secondmate' ? m.projects : (m.project && path.basename(m.project));
    for (const pr of m.prs) if (!c.prs.includes(pr)) c.prs.push(pr);
    // pr recorded but window gone -> awaiting merge, not actively worked.
    if (m.prs.length && windows && m.window && /^[^:]+:.+$/.test(m.window) &&
        !windows.has(m.window) && c.column === 'inflight') {
      c.column = 'waiting';
    }
  }

  // Waiting-section backlog items override inflight placement.
  for (const it of backlog.waiting) {
    const c = draft(it.id);
    c.column = 'waiting';
    c.title = trimTrailingParen(it.text) || it.id;
    c.summary = it.text;
    if (it.repo) c.repo = it.repo;
    for (const m of it.text.matchAll(/https?:\/\/\S+/g)) {
      const url = m[0].replace(/[),.;]+$/, '');
      if (!c.prs.includes(url)) c.prs.push(url);
    }
  }

  // Most-recent Done entries (the section lists newest first). Merged work is OFF the
  // board: verb "merged" is the fully-finished terminal state with nothing actionable
  // left, so those entries never emit; shipped/reported/fixed/etc still do (the done
  // column means delivered-awaiting-action). Reuses the same done-tail verb parse the
  // alias promotion relies on.
  for (const it of backlog.done.filter((d) => (d.verb || '') !== 'merged').slice(0, opts.done)) {
    const c = draft(it.id);
    c.column = 'done';
    c.title = trimTrailingParen(it.text) || it.id;
    c.summary = it.text;
    if (it.repo) c.repo = it.repo;
    c.doneUrl = it.url;
    c.verb = it.verb;
  }

  // Alias resolution: aliased tasks emit no card; a live (inflight) aliased task
  // promotes its target card to inflight. Resolution happens in main(), because the
  // target may live in another owner's output or only on the board.
  const promos = [];
  const aliases = parseAliases(path.join(home, 'data', 'board-aliases'));
  for (const [taskId, target] of aliases) {
    const c = cards.get(taskId);
    if (!c || !c.column) continue; // task gone -> alias dormant, target falls back naturally
    cards.delete(taskId);
    if (c.column === 'inflight') promos.push({ target, task: taskId, owner });
  }

  // Materialize board cards.
  const out = [];
  for (const [id, c] of cards) {
    if (!c.column) continue;
    const card = {
      id: owner === 'firstmate' ? id : owner + ':' + id,
      column: c.column,
      title: c.title,
      owner,
    };
    if (c.summary) card.summary = c.summary;
    const badges = [];
    if (c.repo) badges.push({ text: c.repo, tone: 'info' });
    if (c.kind && c.kind !== 'ship') badges.push({ text: c.kind, tone: 'neutral' });
    const links = [];
    if (c.column === 'done') {
      if (c.doneUrl && /^https?:\/\//.test(c.doneUrl)) {
        const n = prNumber(c.doneUrl);
        links.push({ text: n ? 'PR #' + n : 'link', url: c.doneUrl });
      }
      const verb = c.verb || 'done';
      badges.push({ text: verb, tone: (verb === 'merged' || verb === 'reported') ? 'success' : 'info' });
      card._doneVerb = verb; // temp, for alias promotion badge rewrite; stripped in main()
    } else {
      for (const pr of c.prs) {
        const n = prNumber(pr);
        links.push({ text: n ? 'PR #' + n : 'PR', url: pr });
      }
      if (c.prs.length) badges.push({ text: 'PR open', tone: 'warn' });
    }
    if (badges.length) card.badges = badges;
    if (links.length) card.links = links;
    out.push(card);
  }
  out.sort((a, b) => (COLUMN_RANK[a.column] - COLUMN_RANK[b.column]) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
  return { cards: out, promos };
}

// ---------- secondmate registry ----------
// "- <id> - <summary> (home: <abs-path>; scope: ...; projects: ...; added <date>)"
function parseSecondmates(file) {
  const out = [];
  const src = readFileSafe(file);
  if (src == null) return out;
  for (const raw of src.split('\n')) {
    const m = /^\s*-\s+(\S+)\s+-\s+.*\(home:\s*([^;)]+)/.exec(raw);
    if (m) out.push({ id: m[1], home: m[2].trim() });
  }
  return out;
}

// ---------- main ----------
function main() {
  const home = path.resolve(opts.home);
  if (!fs.existsSync(home)) { warn('home does not exist: ' + home); process.exit(0); }
  const windows = liveWindows();
  if (windows == null) warn('tmux unavailable; window liveness unknown (no waiting demotion)');

  const gen = cardsForHome(home, opts.owner, windows);
  let upsert = gen.cards;
  let promos = gen.promos;
  const owners = new Set([opts.owner]);

  if (opts.secondmates) {
    for (const sm of parseSecondmates(path.join(home, 'data', 'secondmates.md'))) {
      if (!fs.existsSync(sm.home)) { warn('secondmate home missing: ' + sm.home + ' (skipped)'); continue; }
      owners.add(sm.id);
      const g = cardsForHome(sm.home, sm.id, windows);
      upsert = upsert.concat(g.cards);
      promos = promos.concat(g.promos);
    }
  }

  // Alias promotions whose target is in the generated output: force it inflight.
  // Targets not generated (curated/standing cards) can only be verified against the
  // board, so they are deferred to the --apply flow; nothing is ever invented.
  const pendingPromos = [];
  for (const p of promos) {
    const t = upsert.find((c) => c.id === p.target);
    if (t) {
      t.column = 'inflight';
      // no stale done-verb badge on an in-flight card; mark it as being reworked
      // (links stay: the done entry's PR link is the very PR being amended)
      t.badges = promotionBadges(t.badges, t._doneVerb);
    } else {
      pendingPromos.push(p);
    }
  }
  for (const c of upsert) delete c._doneVerb; // internal annotation, never emitted

  // The column frame is skill-owned: emitted for inspection in stdout mode and pushed on
  // --apply via the server's idempotent columns field (identical columns = server no-op).
  const doc = { upsert, remove: [], columns: COLUMNS };

  if (!opts.apply) {
    for (const p of pendingPromos) {
      warn('advisory: alias target "' + p.target + '" for task ' + p.task + ' (owner ' + p.owner +
        ') not in generated output — board not checked without --apply; nothing emitted');
    }
    process.stdout.write(JSON.stringify(doc, null, 2) + '\n');
    return;
  }

  // Like bridge-axi, the port selects the server; a server serves one board fixed at
  // launch, so --board is verified against /api/status rather than sent per-request.
  const base = 'http://127.0.0.1:' + opts.port;
  request('GET', base + '/api/status').then((st) => {
    if (st && st.board && st.board !== opts.board) {
      warn('server on port ' + opts.port + ' serves board "' + st.board + '", not "' + opts.board + '" — not applying');
      process.exit(1);
    }
    return request('GET', base + '/api/board');
  }).then((board) => {
    const boardCards = (board && Array.isArray(board.cards) ? board.cards : []);
    // Deferred alias promotions: target exists on the board -> minimal column patch,
    // with its current board badges rewritten (done-verb stripped, "reworking" added);
    // the server merge keeps every other field. Unknown target -> advisory only.
    for (const p of pendingPromos) {
      const bc = boardCards.find((c) => c && c.id === p.target);
      if (bc) upsert.push({ id: p.target, column: 'inflight', badges: promotionBadges(bc.badges) });
      else warn('advisory: alias target "' + p.target + '" for task ' + p.task + ' (owner ' + p.owner +
        ') not on board or in generated output; nothing emitted');
    }
    const emitted = new Set(upsert.map((c) => c.id));
    const stale = boardCards
      .filter((c) => c && owners.has(c.owner) && !emitted.has(c.id) && taskShaped(c.id))
      .map((c) => c.id);
    if (stale.length) warn('advisory: board cards not regenerated (stale?): ' + stale.join(', '));
    // Sticky curation: cards already on the board keep their (possibly hand-retouched)
    // title/summary — strip both from the upsert so the server merge preserves them.
    // Brand-new cards keep the generated title/summary as a seed.
    const existing = new Set(boardCards.filter((c) => c && c.id).map((c) => c.id));
    for (const c of upsert) {
      if (existing.has(c.id)) { delete c.title; delete c.summary; }
    }
    return request('PATCH', base + '/api/cards', doc);
  }).then((reply) => {
    process.stdout.write(JSON.stringify(reply) + '\n');
  }).catch((e) => { warn('apply failed: ' + e.message); process.exit(1); });
}

// Kebab task ids end in a short random suffix (fix-login-k3, thumb-guards-m4).
function taskShaped(id) {
  return typeof id === 'string' && /-[a-z]{1,2}\d{1,2}$/.test(id.replace(/^[^:]+:/, ''));
}

function request(method, url, body) {
  return new Promise((resolve, reject) => {
    const data = body == null ? null : JSON.stringify(body);
    const req = http.request(url, {
      method,
      headers: data ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } : {},
      timeout: 10000,
    }, (res) => {
      let out = '';
      res.on('data', (c) => (out += c));
      res.on('end', () => {
        if (res.statusCode >= 400) return reject(new Error('HTTP ' + res.statusCode + ': ' + out));
        try { resolve(JSON.parse(out)); } catch (e) { resolve(out); }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timeout')));
    req.on('error', reject);
    if (data) req.write(data);
    req.end();
  });
}

main();
