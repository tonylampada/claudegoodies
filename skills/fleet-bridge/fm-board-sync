#!/usr/bin/env node
// fm-board-sync — event/attribute FEEDER from a firstmate home's on-disk state
// onto a bridge v2 board. Node built-ins only, zero deps. Never writes to the
// firstmate home; never moves columns; never touches title/body/labels of
// existing cards. Column moves are deliberate lifecycle acts of the agent or
// the human — this generator only feeds.
//
// What it does per run:
//   1. Ensures the canonical 4-column frame (PUT /api/columns, idempotent).
//   2. Creates cards for NEW in-flight work (backlog In flight + live state/*.meta),
//      born in "working" with type/repo/owner attributes and a seed body.
//   3. Appends timeline events for detected signals, deduped by exact text:
//        - "PR opened <url>" when meta records pr=          (level 2)
//        - status-file lines: done/failed/needs-decision/blocked -> level 1
//          (success/alert/question/alert), other lines -> level 2
//   4. Patches pr / pr_state attributes when they change.
//   5. Feeds the `worker` attribute (the UI's left-edge stripe) from REAL
//      crewmate state: busy pane -> working, parked on needs-decision/blocked
//      -> needs-you, alive-but-idle window -> idle, dead/no window -> cleared
//      (attribute removed, no stripe). Derived from state/<id>.meta +
//      state/<id>.status + one batched tmux window list + bounded per-task
//      pane captures — never from fm-crew-state.sh (which shells out to
//      no-mistakes with multi-second timeouts per task; too slow for a
//      run-on-every-wake feeder).
//   6. Archives a card when its task lands in backlog Done with verb "merged"
//      (kill = archive; the card leaves the board, one level-1 ✅ notification).
//
// Aliases: <home>/data/board-aliases lines "<task-id> <card-id>" feed a task's
// events/attributes onto an existing card (e.g. a captain-created card that
// became real work, or a follow-up task amending an earlier card) instead of
// creating a new one.
//
// Usage:
//   fm-board-sync [--home <path>] [--owner <name>] [--no-secondmates]
//                 [--apply] [--port <p>] [--board <name>]
// Without --apply: prints the planned actions as JSON (nothing is sent).
'use strict';

const fs = require('fs');
const path = require('path');
const http = require('http');
const { execFileSync } = require('child_process');

function warn(msg) { process.stderr.write('fm-board-sync: ' + msg + '\n'); }

// ---------- args ----------
const argv = process.argv.slice(2);
const opts = {
  home: process.env.FM_HOME || process.cwd(),
  owner: 'firstmate',
  secondmates: true,
  apply: false,
  port: 4777,
  board: 'default',
};
for (let i = 0; i < argv.length; i++) {
  const a = argv[i];
  if (a === '--home') opts.home = argv[++i];
  else if (a === '--owner') opts.owner = argv[++i];
  else if (a === '--no-secondmates') opts.secondmates = false;
  else if (a === '--apply') opts.apply = true;
  else if (a === '--port') opts.port = parseInt(argv[++i], 10);
  else if (a === '--board') opts.board = argv[++i];
  else { warn('unknown option: ' + a); process.exit(2); }
}
const BASE = 'http://127.0.0.1:' + opts.port;

// ---------- canonical column frame (skill-owned) ----------
const COLUMNS = [
  { id: 'ideas', title: '💡 Ideas' },
  { id: 'working', title: '🔨 Working' },
  { id: 'review', title: '👀 Your review' },
  { id: 'peer', title: '🤝 Peer review' },
];
const BIRTH_COLUMN = 'working'; // new detected work is already being worked

// ---------- helpers ----------
function readFileSafe(file) {
  try { return fs.readFileSync(file, 'utf8'); } catch (e) { return null; }
}
function trimTrailingParen(text) {
  return text.replace(/\s*\([^()]*\)\s*$/, '').trim();
}

// ---------- backlog parsing ----------
// {inflight:[{id,text,repo}], done:[{id,text,url,verb}]}
function parseBacklog(file) {
  const out = { inflight: [], done: [] };
  const src = readFileSafe(file);
  if (src == null) { warn('no backlog at ' + file + ' (skipped)'); return out; }
  let section = null;
  for (const raw of src.split('\n')) {
    const h2 = /^##\s+(.*)$/.exec(raw);
    if (h2) {
      const t = h2[1].replace(/^[^A-Za-z0-9]+/, '');
      if (/^in flight/i.test(t)) section = 'inflight';
      else if (/^done\b/i.test(t)) section = 'done';
      else section = null;
      continue;
    }
    if (/^###/.test(raw)) continue;
    if (!section) continue;
    const item = /^\s*- (?:\[( |x)\]\s+)?\**(\S+?)\**\s+-\s+(.*\S)\s*$/.exec(raw);
    if (!item) continue;
    const id = item[2];
    const text = item[3];
    const rec = { id, text, repo: null, url: null, verb: null };
    const repoM = /\(repo:\s*([^,;)]+)/.exec(text);
    if (repoM) rec.repo = repoM[1].trim();
    if (section === 'done') {
      // "- [x] <id> - <one line> - <url-or-path-or-note> (<verb> <date>)"
      const tail = /^(.*\S)\s+-\s+(.+?)\s+\((\w+)[^)]*\)\s*$/.exec(text);
      if (tail) { rec.text = tail[1]; rec.url = tail[2]; rec.verb = tail[3].toLowerCase(); }
    }
    out[section].push(rec);
  }
  return out;
}

// ---------- meta / status parsing ----------
function parseMetas(stateDir) {
  const metas = new Map(); // id -> {kind, project, window, backend, prs[]}
  let names;
  try { names = fs.readdirSync(stateDir).filter((n) => n.endsWith('.meta')).sort(); }
  catch (e) { return metas; }
  for (const name of names) {
    const id = name.slice(0, -'.meta'.length);
    const src = readFileSafe(path.join(stateDir, name));
    if (src == null) continue;
    const m = { kind: null, project: null, window: null, backend: null, prs: [] };
    for (const line of src.split('\n')) {
      const kv = /^(\w+)=(.*)$/.exec(line.trim());
      if (!kv) continue;
      if (kv[1] === 'pr') { if (kv[2] && !m.prs.includes(kv[2])) m.prs.push(kv[2]); }
      else if (kv[1] in m) m[kv[1]] = kv[2];
    }
    metas.set(id, m);
  }
  return metas;
}
function parseStatus(stateDir, id) {
  const src = readFileSafe(path.join(stateDir, id + '.status'));
  if (src == null) return [];
  return src.split('\n').map((s) => s.trim()).filter(Boolean);
}

// status line -> {level, kind} (handoff-worthy signals are level 1)
function classifyStatusLine(line) {
  if (/^done\b/i.test(line)) return { level: 1, kind: 'success' };
  if (/^failed\b/i.test(line)) return { level: 1, kind: 'alert' };
  if (/^needs-decision\b/i.test(line)) return { level: 1, kind: 'question' };
  if (/^blocked\b/i.test(line)) return { level: 1, kind: 'alert' };
  return { level: 2, kind: 'info' };
}

// ---------- worker state (the card's left-edge stripe) ----------
// Derived from meta + status files + tmux, NOT from fm-crew-state.sh: that
// helper shells out to no-mistakes with a multi-second timeout per task, which
// is too slow for a feeder that runs on every wake. tmux cost is bounded to
// ONE `list-windows -a` per run plus at most MAX_PANE_PROBES `capture-pane`
// calls (only for tasks whose window is live).
const MAX_PANE_PROBES = 40;
let panesProbed = 0;
// Busy footers per harness (mirrors firstmate's fm-tmux-lib.sh):
// claude/codex "esc to interrupt", opencode "esc interrupt", pi "Working...",
// grok "Ctrl+c:cancel".
const BUSY_RE = /esc (to )?interrupt|Working\.\.\.|Ctrl\+c:cancel/i;

function tmuxExec(args) {
  try {
    return execFileSync('tmux', args, { encoding: 'utf8', timeout: 3000, stdio: ['ignore', 'pipe', 'ignore'] });
  } catch (e) { return null; }
}
// One batched liveness read; a failure (no tmux, no server) means no live
// windows, which correctly clears every stripe.
let liveWindowsCache = null;
function liveWindows() {
  if (liveWindowsCache) return liveWindowsCache;
  const full = new Set(); const bare = new Set();
  const out = tmuxExec(['list-windows', '-a', '-F', '#{session_name}:#{window_name}']);
  if (out != null) {
    for (const line of out.split('\n')) {
      const t = line.trim();
      if (!t) continue;
      full.add(t);
      bare.add(t.slice(t.indexOf(':') + 1));
    }
  }
  liveWindowsCache = { full, bare };
  return liveWindowsCache;
}
function windowIsLive(target) {
  const lw = liveWindows();
  const base = target.replace(/\.\d+$/, ''); // tolerate a pane suffix
  return lw.full.has(target) || lw.full.has(base) ||
    (!base.includes(':') && lw.bare.has(base));
}
function paneIsBusy(target) {
  if (panesProbed >= MAX_PANE_PROBES) return null; // budget spent: unknown
  panesProbed++;
  const out = tmuxExec(['capture-pane', '-p', '-t', target, '-S', '-40']);
  if (out == null) return null;
  const tail = out.split('\n').filter((l) => l.trim()).slice(-6).join('\n');
  return BUSY_RE.test(tail);
}
// Leading verb of the last non-empty status line ("needs-decision: x" -> "needs-decision").
function lastStatusVerb(statusLines) {
  if (!statusLines.length) return null;
  const line = statusLines[statusLines.length - 1];
  return line.split(':')[0].trim().toLowerCase();
}
// -> 'working' | 'needs-you' | 'idle' | null (clear: no live worker) |
//    undefined (unreadable here — leave the attribute untouched)
function workerState(m, statusLines) {
  if (!m || !m.window) return null;                 // never spawned / torn down
  if (m.backend && m.backend !== 'tmux') return undefined; // non-tmux backend: no cheap read
  if (!windowIsLive(m.window)) return null;         // dead window: no stripe
  const busy = paneIsBusy(m.window);
  if (busy === null && panesProbed >= MAX_PANE_PROBES) return undefined; // over budget
  if (busy) return 'working';                       // actively producing
  const verb = lastStatusVerb(statusLines);
  if (verb === 'needs-decision' || verb === 'blocked') return 'needs-you';
  return 'idle';                                    // alive but parked
}

// ---------- aliases: "<task-id> <card-id>" ----------
function parseAliases(file) {
  const map = new Map();
  const src = readFileSafe(file);
  if (src == null) return map;
  for (const raw of src.split('\n')) {
    const line = raw.replace(/#.*$/, '').trim();
    if (!line) continue;
    const m = /^(\S+)\s+(\S+)$/.exec(line);
    if (m) map.set(m[1], m[2]);
    else warn('bad alias line in ' + file + ': ' + raw.trim());
  }
  return map;
}

// ---------- secondmate registry ----------
function parseSecondmates(file) {
  const out = [];
  const src = readFileSafe(file);
  if (src == null) return out;
  for (const raw of src.split('\n')) {
    const m = /^\s*-\s+(\S+)\s+-\s+.*\(home:\s*([^;)]+)/.exec(raw);
    if (m) out.push({ id: m[1], home: m[2].trim() });
  }
  return out;
}

// ---------- plan for one home ----------
// Emits {creates:[card], events:[{card,text,level,kind}], attrs:[{card,attributes}],
//        archives:[{card,reason}], workerDecided:Set<cardId>} against the board
// snapshot. workerDecided = cards whose worker stripe this home owns this run
// (set, cleared, or deliberately left alone); main() clears the stripe on any
// other owned card that still carries one.
function planHome(home, owner, board) {
  const backlog = parseBacklog(path.join(home, 'data', 'backlog.md'));
  const stateDir = path.join(home, 'state');
  const metas = parseMetas(stateDir);
  const aliases = parseAliases(path.join(home, 'data', 'board-aliases'));
  const plan = { creates: [], events: [], attrs: [], archives: [], workerDecided: new Set() };

  const cardId = (taskId) =>
    aliases.get(taskId) || (owner === 'firstmate' ? taskId : owner + ':' + taskId);
  const boardCard = (id) => (board.cards || []).find((c) => c.id === id);

  // A card that is an ALIAS TARGET is owned, for worker purposes, by the
  // aliasing (rework) task alone. An alias line "<rework-task> <card-id>" means
  // the rework task rides that existing card; the aliasing task's live window is
  // authoritative. A different, same-named ORIGINAL task (e.g. the torn-down
  // task the card was born from) must NOT also feed worker onto that card, or
  // the two sources fight per run and the stripe flickers idle <-> gone. Cards
  // reached only via the default id mapping (not an alias) are unaffected.
  const aliasTargetCards = new Set(aliases.values());

  // Feed the worker stripe for one card, deterministically: at most ONE worker
  // decision per card per run. `card` may be null (no board card and not being
  // created): nothing to feed then. undefined state = leave as-is, but still
  // ours (protects it from the stale-worker sweep in main()). A second attempt
  // to decide the same card in one run is ignored (the first, authoritative
  // source wins); callers order the authoritative source first.
  const feedWorker = (id, card, w) => {
    if (plan.workerDecided.has(id)) return; // already decided this run — no double-write
    plan.workerDecided.add(id);
    if (w === undefined || !card) return;
    const cur = (card.attributes || {}).worker;
    if (card._new) { if (w) card.attributes.worker = w; return; }
    if (w === null ? cur != null : cur !== w) {
      plan.attrs.push({ card: id, attributes: { worker: w } }); // null deletes on PATCH
    }
  };

  // live tasks = in-flight backlog items U live metas (minus secondmate self-records)
  const live = new Map(); // taskId -> {title, repo, kind}
  for (const it of backlog.inflight) {
    live.set(it.id, { title: trimTrailingParen(it.text) || it.id, repo: it.repo, kind: null });
  }
  for (const [id, m] of metas) {
    if (m.kind === 'secondmate') {
      live.delete(id);
      continue;
    }
    const t = live.get(id) || { title: id, repo: null, kind: null };
    if (m.kind) t.kind = m.kind;
    if (!t.repo && m.project) t.repo = path.basename(m.project);
    live.set(id, t);
  }

  // Worker stripe is decided ALIAS-FIRST so the aliasing (rework) task is the
  // authoritative source for an alias-target card, before any same-named
  // original task (whose torn-down window would otherwise clear that card).
  // feedWorker() is idempotent per card, so the first (alias) decision wins and
  // the original task's later attempt on the same card is a no-op. A task
  // reaching a card by the default id mapping (not through an alias) is not
  // pre-decided here, so non-aliased cards behave exactly as before.
  for (const [taskId, targetCard] of aliases) {
    const m = metas.get(taskId);
    if (!m) continue; // alias to a task with no meta: nothing live to feed
    const card = boardCard(targetCard);
    if (!card) continue; // alias target not on the board yet (created below if it is live work)
    feedWorker(targetCard, card, workerState(m, parseStatus(stateDir, taskId)));
  }

  // Secondmate self-records create no card, but a card may exist for one (alias
  // or direct id); feed its worker stripe from the live pane. The alias-first
  // loop above already covered any secondmate task used as an alias source, and
  // feedWorker() is idempotent, so this only fills self-record cards not yet
  // decided.
  for (const [id, m] of metas) {
    if (m.kind !== 'secondmate') continue;
    const cid = cardId(id);
    feedWorker(cid, boardCard(cid), workerState(m, parseStatus(stateDir, id)));
  }

  // pending events/attrs for a card id, deduped later against board card events
  for (const [taskId, t] of live) {
    const id = cardId(taskId);
    let card = boardCard(id);
    if (!card) {
      // NEW work: the only time this feeder creates (and seeds title/body)
      const type = t.kind === 'scout' ? 'investigation' : 'implementation';
      const attributes = { type, owner };
      if (t.repo) attributes.repo = t.repo;
      card = {
        id, title: t.title, column: BIRTH_COLUMN, attributes,
        body: t.title + (t.repo ? ' (' + t.repo + ')' : ''),
      };
      plan.creates.push(card);
      card._new = true;
    }
    const have = new Set(((card.events) || []).map((e) => e.text));
    const addEvent = (text, level, kind) => {
      if (have.has(text)) return;
      have.add(text);
      plan.events.push({ card: id, text, level, kind });
    };

    // PR recorded in meta -> attribute + one "PR opened" event
    const m = metas.get(taskId);
    if (m && m.prs.length) {
      const pr = m.prs[m.prs.length - 1];
      const at = (card.attributes) || {};
      if (at.pr !== pr && !card._new) plan.attrs.push({ card: id, attributes: { pr, pr_state: 'open' } });
      else if (card._new) { card.attributes.pr = pr; card.attributes.pr_state = 'open'; }
      addEvent('PR opened: ' + pr, 2, 'info');
    }

    // status-file lines -> timeline events
    const statusLines = parseStatus(stateDir, taskId);
    for (const line of statusLines) {
      const c = classifyStatusLine(line);
      addEvent(line, c.level, c.kind);
    }

    // worker stripe from real crewmate state (set when changed, clear when gone)
    feedWorker(id, card, workerState(m, statusLines));
  }

  // merged Done entries -> archive the card (kill = off the board)
  for (const it of backlog.done) {
    if ((it.verb || '') !== 'merged') continue;
    const id = cardId(it.id);
    const card = boardCard(id);
    if (!card) continue; // already archived / never on the board
    const where = it.url && /^https?:\/\//.test(it.url) ? it.url : 'local main';
    plan.archives.push({ card: id, reason: 'merged: ' + where });
  }

  return plan;
}

// ---------- http ----------
function request(method, urlPath, body) {
  return new Promise((resolve, reject) => {
    const data = body == null ? null : JSON.stringify(body);
    const req = http.request(BASE + urlPath, {
      method,
      headers: data ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(data) } : {},
      timeout: 10000,
    }, (res) => {
      let out = '';
      res.on('data', (c) => (out += c));
      res.on('end', () => {
        if (res.statusCode >= 400) return reject(new Error('HTTP ' + res.statusCode + ' ' + urlPath + ': ' + out));
        try { resolve(JSON.parse(out)); } catch (e) { resolve(out); }
      });
    });
    req.on('timeout', () => req.destroy(new Error('timeout')));
    req.on('error', reject);
    if (data) req.write(data);
    req.end();
  });
}

// ---------- main ----------
async function main() {
  const home = path.resolve(opts.home);
  if (!fs.existsSync(home)) { warn('home does not exist: ' + home); process.exit(0); }

  // A server serves one board fixed at launch; verify before feeding anything.
  let board = { cards: [] };
  let serverOk = false;
  try {
    const st = await request('GET', '/api/status');
    if (st && st.board && st.board !== opts.board) {
      warn('server on port ' + opts.port + ' serves board "' + st.board + '", not "' + opts.board + '" — refusing');
      process.exit(1);
    }
    board = await request('GET', '/api/board');
    serverOk = true;
  } catch (e) {
    warn('server not reachable on port ' + opts.port + ': ' + e.message + (opts.apply ? '' : ' (planning against empty board)'));
    if (opts.apply) process.exit(1);
  }

  // merge plans across the main home and each secondmate home
  const plan = { columns: COLUMNS, creates: [], events: [], attrs: [], archives: [] };
  const homes = [{ home, owner: opts.owner }];
  if (opts.secondmates) {
    for (const sm of parseSecondmates(path.join(home, 'data', 'secondmates.md'))) {
      if (!fs.existsSync(sm.home)) { warn('secondmate home missing: ' + sm.home + ' (skipped)'); continue; }
      homes.push({ home: sm.home, owner: sm.id });
    }
  }
  const workerDecided = new Set();
  for (const h of homes) {
    const p = planHome(h.home, h.owner, board);
    plan.creates.push(...p.creates);
    plan.events.push(...p.events);
    plan.attrs.push(...p.attrs);
    plan.archives.push(...p.archives);
    for (const id of p.workerDecided) workerDecided.add(id);
  }
  for (const c of plan.creates) delete c._new;

  // Stale-worker sweep: a board card still striped whose task no longer exists
  // in any planned home (meta gone after teardown) gets its stripe cleared.
  // Scoped to cards owned by the homes we actually planned, so cards of a
  // skipped home (--no-secondmates, missing home) are never touched.
  const plannedOwners = new Set(homes.map((h) => h.owner));
  for (const c of board.cards || []) {
    const at = c.attributes || {};
    if (!at.worker || workerDecided.has(c.id)) continue;
    if (!plannedOwners.has(at.owner)) continue;
    plan.attrs.push({ card: c.id, attributes: { worker: null } });
  }

  if (!opts.apply) {
    process.stdout.write(JSON.stringify(plan, null, 2) + '\n');
    return;
  }

  // apply: columns (idempotent) -> creates -> attrs -> events -> archives
  await request('PUT', '/api/columns', plan.columns);
  let n = { created: 0, events: 0, attrs: 0, archived: 0 };
  for (const c of plan.creates) {
    try { await request('POST', '/api/cards', c); n.created++; }
    catch (e) { warn('create ' + c.id + ' failed: ' + e.message); }
  }
  for (const a of plan.attrs) {
    try { await request('PATCH', '/api/cards/' + encodeURIComponent(a.card), { attributes: a.attributes }); n.attrs++; }
    catch (e) { warn('attrs ' + a.card + ' failed: ' + e.message); }
  }
  for (const ev of plan.events) {
    try {
      await request('POST', '/api/cards/' + encodeURIComponent(ev.card) + '/events',
        { text: ev.text, level: ev.level, kind: ev.kind, actor: 'sync' });
      n.events++;
    } catch (e) { warn('event ' + ev.card + ' failed: ' + e.message); }
  }
  for (const ar of plan.archives) {
    try { await request('POST', '/api/cards/' + encodeURIComponent(ar.card) + '/archive', { reason: ar.reason, actor: 'sync' }); n.archived++; }
    catch (e) { warn('archive ' + ar.card + ' failed: ' + e.message); }
  }
  process.stdout.write(JSON.stringify(n) + '\n');
}

main().catch((e) => { warn(e.message); process.exit(1); });
