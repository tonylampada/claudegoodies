"""Find Avoma meeting UUIDs in recent AgentMail inbox messages."""
from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
from typing import Any

from agentmail import AgentMail

HERE = Path(__file__).resolve().parent
EXTRACTOR_PATH = HERE / "avoma-meeting-id-from-email"
loader = importlib.machinery.SourceFileLoader("avoma_meeting_id_from_email", str(EXTRACTOR_PATH))
spec = importlib.util.spec_from_loader(loader.name, loader)
extractor = importlib.util.module_from_spec(spec)
loader.exec_module(extractor)  # type: ignore[arg-type]


def as_jsonable(obj: Any) -> Any:
    if hasattr(obj, "model_dump"):
        return obj.model_dump(mode="json")
    if hasattr(obj, "dict"):
        return obj.dict()
    return obj


def main() -> int:
    ap = argparse.ArgumentParser(description="List Avoma meeting UUIDs from recent AgentMail messages.")
    ap.add_argument("--inbox", default=os.environ.get("AGENTMAIL_INBOX_ID", "jarbas2@agentmail.to"))
    ap.add_argument("--limit", type=int, default=25)
    ap.add_argument("--api-key-env", default="AGENTMAIL_API_KEY")
    ap.add_argument("--json", action="store_true")
    args = ap.parse_args()

    api_key = os.environ.get(args.api_key_env)
    if not api_key:
        raise SystemExit(f"Missing {args.api_key_env}")

    client = AgentMail(api_key=api_key)
    page = client.inboxes.messages.list(
        args.inbox,
        limit=args.limit,
        include_spam=True,
        include_blocked=True,
        include_unauthenticated=True,
    )

    rows = []
    for summary in page.messages:
        sd = as_jsonable(summary)
        hay = json.dumps(sd, ensure_ascii=False).lower()
        if "avoma" not in hay and "ai notes" not in hay:
            continue
        mid = sd.get("message_id") or sd.get("messageId") or sd.get("id")
        if not mid:
            continue
        full = client.inboxes.messages.get(args.inbox, mid)
        d = as_jsonable(full)
        ids = extractor.extract_ids(json.dumps(d, ensure_ascii=False))
        if not ids:
            continue
        rows.append({
            "created_at": d.get("created_at") or d.get("timestamp"),
            "from": d.get("from") or d.get("from_"),
            "subject": d.get("subject"),
            "message_id": mid,
            "meeting_uuids": ids,
        })

    if args.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    else:
        for r in rows:
            print(f"{r['meeting_uuids'][0]}\t{r.get('created_at') or '-'}\t{r.get('subject') or '-'}")
    return 0 if rows else 1


if __name__ == "__main__":
    raise SystemExit(main())
